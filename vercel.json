{
  "version": 2,
  "name": "serenita-staff",
  "builds": [
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/frontend/index.html" },
    { "src": "/dashboard", "dest": "/frontend/dashboard.html" },
    { "src": "/citas", "dest": "/frontend/citas.html" },
    { "src": "/cita/:id", "dest": "/frontend/cita-detalle.html" },
    { "src": "/perfil", "dest": "/frontend/perfil.html" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
